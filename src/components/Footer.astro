---
---
<footer style="background-color: var(--color-brown-dark); color: #e8d5c4">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Logo & tagline -->
      <div>
        <a href="/" class="flex items-center gap-3 mb-4">
          <img
            src="/images/logo.jpeg"
            alt="Cofferino Hub"
            class="h-12 w-auto object-contain"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
          />
          <div class="hidden items-center gap-2">
            <div class="w-10 h-10 rounded-full flex items-center justify-center" style="background-color: var(--color-warm)">
              <span class="text-white font-black text-lg">C</span>
            </div>
            <span class="font-black text-xl text-white">Cofferino</span>
          </div>
        </a>
        <p class="text-sm leading-relaxed opacity-80">
          Un loc cald și sigur unde copiii descoperă, creează și se bucură de copilărie.
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="font-800 text-white mb-4 text-base">Pagini</h3>
        <ul class="space-y-2 text-sm opacity-80">
          <li><a href="/afterschool" class="hover:text-amber-300 transition-colors">Afterschool</a></li>
          <li><a href="/program-de-vara" class="hover:text-amber-300 transition-colors">Program de Vară</a></li>
          <li><a href="/vacanta-an-scolar" class="hover:text-amber-300 transition-colors">Vacanță Școlară</a></li>
          <li><a href="/galerie" class="hover:text-amber-300 transition-colors">Galerie</a></li>
          <li><a href="/contact" class="hover:text-amber-300 transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-800 text-white mb-4 text-base">Contact</h3>
        <ul class="space-y-3 text-sm opacity-80">
          <li class="flex items-center gap-2">
            <span>📧</span>
            <a href="mailto:cofferino.afterschool@gmail.com" class="hover:text-amber-300 transition-colors">
              cofferino.afterschool@gmail.com
            </a>
          </li>
          <li class="flex items-center gap-2">
            <span>📞</span>
            <a href="tel:+40736510904" class="hover:text-amber-300 transition-colors">
              0736 510 904
            </a>
          </li>
          <li class="flex items-start gap-2">
            <span>📍</span>
            <span>Strada Elena Caragiani 20a, București 014214</span>
          </li>
        </ul>

        <!-- Social -->
        <div class="flex gap-3 mt-5">
          <a
            href="https://www.facebook.com/cofferinoafterschool"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full flex items-center justify-center transition-colors"
            style="background-color: rgba(255,255,255,0.15)"
            aria-label="Facebook"
          >
            <svg class="w-4 h-4 text-white fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/cofferino_afterschool/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full flex items-center justify-center transition-colors"
            style="background-color: rgba(255,255,255,0.15)"
            aria-label="Instagram"
          >
            <svg class="w-4 h-4 text-white fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="border-t mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs opacity-60" style="border-color: rgba(255,255,255,0.15)">
      <p>© {new Date().getFullYear()} Cofferino Hub. Toate drepturile rezervate.</p>
      <a href="/politica-confidentialitate" class="hover:opacity-100 transition-opacity">Politica de confidențialitate</a>
    </div>
  </div>
</footer>
