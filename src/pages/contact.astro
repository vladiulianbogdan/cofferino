---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const data = (await getEntry('pages', 'contact'))?.data as any;
---
<Layout title="Contact" description="Contactează echipa Cofferino Hub">
  <!-- HERO -->
  <section class="hero-section" style="min-height: 340px">
    <div class="absolute inset-0">
      <img src={data.hero_image} alt="Contact Cofferino" class="w-full h-full object-cover"
        onerror="this.src='/images/placeholder-hero.svg'" />
      <div class="hero-overlay"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 py-16 text-white">
      <h1 class="text-4xl sm:text-5xl font-black mb-4" style="color: white; text-shadow: 0 2px 8px rgba(0,0,0,0.3)">
        {data.hero_title}
      </h1>
      <p class="text-lg opacity-90 max-w-xl">{data.hero_subtitle}</p>
    </div>
  </section>

  <!-- CONTACT CARDS -->
  <section class="py-20" style="background-color: var(--color-cream)">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-16">
        <div class="card p-6 text-center">
          <div class="text-4xl mb-3">📧</div>
          <div class="font-700 mb-2" style="color: var(--color-brown-dark)">Email</div>
          <a href={`mailto:${data.email}`} class="text-sm font-600 hover:underline" style="color: var(--color-warm)">
            {data.email}
          </a>
        </div>
        <div class="card p-6 text-center">
          <div class="text-4xl mb-3">📞</div>
          <div class="font-700 mb-2" style="color: var(--color-brown-dark)">Telefon</div>
          <a href={`tel:${data.phone?.replace(/\s/g,'')}`} class="text-sm font-600 hover:underline" style="color: var(--color-warm)">
            {data.phone}
          </a>
        </div>
        <div class="card p-6 text-center">
          <div class="text-4xl mb-3">📍</div>
          <div class="font-700 mb-2" style="color: var(--color-brown-dark)">Adresă</div>
          <p class="text-sm" style="color: var(--color-text-muted)">{data.address}</p>
          <p class="text-xs mt-1" style="color: var(--color-text-muted)">{data.program_contact}</p>
        </div>
      </div>

      <!-- MAP -->
      <div class="rounded-2xl overflow-hidden shadow-lg" style="height: 420px">
        <iframe
          src={data.maps_embed}
          width="100%"
          height="420"
          style="border: 0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Locație Cofferino Hub"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
