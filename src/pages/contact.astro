---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const data = (await getEntry('pages', 'contact'))?.data as any;
---
<Layout title="Contact" description="Contactează echipa Cofferino Hub">
  <!-- HERO -->
  <section class="hero-section" style="min-height: 340px">
    <div class="absolute inset-0">
      <img src={data.hero_image} alt="Contact Cofferino" class="w-full h-full object-cover"
        onerror="this.src='/images/placeholder-hero.svg'" />
      <div class="hero-overlay"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 py-16 text-white">
      <h1 class="text-4xl sm:text-5xl font-black mb-4" style="color: white; text-shadow: 0 2px 8px rgba(0,0,0,0.3)">
        {data.hero_title}
      </h1>
      <p class="text-lg opacity-90 max-w-xl">{data.hero_subtitle}</p>
    </div>
  </section>

  <!-- CONTACT CARDS -->
  <section class="py-20" style="background-color: var(--color-cream)">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-16">
        <div class="card p-6 text-center">
          <div class="text-4xl mb-3">📧</div>
          <div class="font-700 mb-2" style="color: var(--color-brown-dark)">Email</div>
          <a href={`mailto:${data.email}`} class="text-sm font-600 hover:underline" style="color: var(--color-warm)">
            {data.email}
          </a>
        </div>
        <div class="card p-6 text-center">
          <div class="text-4xl mb-3">📞</div>
          <div class="font-700 mb-2" style="color: var(--color-brown-dark)">Telefon</div>
          <a href={`tel:${data.phone?.replace(/\s/g,'')}`} class="text-sm font-600 hover:underline" style="color: var(--color-warm)">
            {data.phone}
          </a>
        </div>
        <div class="card p-6 text-center">
          <div class="text-4xl mb-3">📍</div>
          <div class="font-700 mb-2" style="color: var(--color-brown-dark)">Adresă</div>
          <p class="text-sm" style="color: var(--color-text-muted)">{data.address}</p>
          <p class="text-xs mt-1" style="color: var(--color-text-muted)">{data.program_contact}</p>
        </div>
      </div>

      <!-- SOCIAL MEDIA -->
      <div class="mb-12">
        <h2 class="text-2xl font-black text-center mb-6" style="color: var(--color-brown-dark)">Urmărește-ne</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl mx-auto">
          <a
            href="https://www.facebook.com/cofferinoafterschool"
            target="_blank"
            rel="noopener noreferrer"
            class="card p-5 flex items-center gap-4 hover:shadow-lg transition-shadow group"
          >
            <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background-color: #1877F2">
              <svg class="w-6 h-6 fill-white" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </div>
            <div>
              <div class="font-700 text-sm" style="color: var(--color-brown-dark)">Facebook</div>
              <div class="text-xs mt-0.5" style="color: var(--color-text-muted)">@cofferinoafterschool</div>
            </div>
            <svg class="w-4 h-4 ml-auto opacity-40 group-hover:opacity-80 transition-opacity" style="color: var(--color-brown)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/cofferino_afterschool/"
            target="_blank"
            rel="noopener noreferrer"
            class="card p-5 flex items-center gap-4 hover:shadow-lg transition-shadow group"
          >
            <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, #f58529, #dd2a7b, #8134af)">
              <svg class="w-6 h-6 fill-white" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div>
              <div class="font-700 text-sm" style="color: var(--color-brown-dark)">Instagram</div>
              <div class="text-xs mt-0.5" style="color: var(--color-text-muted)">@cofferino_afterschool</div>
            </div>
            <svg class="w-4 h-4 ml-auto opacity-40 group-hover:opacity-80 transition-opacity" style="color: var(--color-brown)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- MAP -->
      <div class="rounded-2xl overflow-hidden shadow-lg" style="height: 420px">
        <iframe
          src={data.maps_embed}
          width="100%"
          height="420"
          style="border: 0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Locație Cofferino Hub"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
