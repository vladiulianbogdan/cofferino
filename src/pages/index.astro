---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const data = (await getEntry('pages', 'home'))?.data as any;
---
<Layout title="Acasă" description={data.hero_subtitle}>
  <!-- HERO -->
  <!-- Mobile: imagine full + text dedesubt | Desktop: text overlay pe imagine -->
  <section>
    <!-- Imagine: pe mobile apare întreagă, pe desktop e cu overlay -->
    <div class="relative">
      <img
        src={data.hero_image}
        alt="Cofferino Hub"
        class="w-full h-auto block"
        onerror="this.src='/images/placeholder-hero.svg'"
      />
      <!-- Overlay + text doar pe desktop (md+) -->
      <div class="hidden md:flex absolute inset-0 flex-col items-center justify-center text-center px-8"
           style="background: linear-gradient(135deg, rgba(74,37,17,0.65) 0%, rgba(106,63,42,0.35) 100%)">
        <h1 class="font-black leading-tight mb-4" style="color: white; text-shadow: 0 2px 10px rgba(0,0,0,0.5); font-size: clamp(2rem, 4vw, 3.5rem)">
          {data.hero_title}
        </h1>
        <p class="mb-6 max-w-xl" style="color: white; opacity: 0.92; font-size: 1.15rem">
          {data.hero_subtitle}
        </p>
        <a href={data.hero_cta_href} style="display: inline-block; background-color: var(--color-warm); color: white; font-weight: 700; padding: 0.875rem 2rem; border-radius: 9999px; text-decoration: none">
          {data.hero_cta_label}
        </a>
      </div>
    </div>

    <!-- Text sub imagine doar pe mobile -->
    <div class="md:hidden text-center px-6 py-8" style="background-color: var(--color-brown-dark)">
      <h1 class="font-black leading-tight mb-3" style="color: white; font-size: 1.75rem">
        {data.hero_title}
      </h1>
      <p class="mb-5" style="color: rgba(255,255,255,0.85); font-size: 1rem">
        {data.hero_subtitle}
      </p>
      <a href={data.hero_cta_href} style="display: inline-block; background-color: var(--color-warm); color: white; font-weight: 700; padding: 0.75rem 1.75rem; border-radius: 9999px; text-decoration: none">
        {data.hero_cta_label}
      </a>
    </div>
  </section>

  <!-- VIZIUNE -->
  <section class="py-20" style="background-color: var(--color-cream)">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="section-title text-3xl sm:text-4xl">{data.viziune_title}</h2>
        <p class="text-lg leading-relaxed" style="color: var(--color-text-muted)">{data.viziune_text}</p>
      </div>
    </div>
  </section>

  <!-- CALITATE / WHY COFFERINO -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="section-title text-center text-3xl sm:text-4xl mb-12">{data.calitate_title}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {data.calitate_items?.map((item: any) => (
          <div class="card p-6 text-center">
            <div class="text-4xl mb-4">{item.icon}</div>
            <h3 class="font-800 text-lg mb-2" style="color: var(--color-brown-dark)">{item.title}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-muted)">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT IMAGE – afișat doar dacă imaginea există -->
  {data.about_image && (
    <section class="py-20" style="background-color: var(--color-cream-dark)">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <img
            src={data.about_image}
            alt="Viața la Cofferino"
            class="w-full h-72 sm:h-96 object-cover"
          />
        </div>
      </div>
    </section>
  )}

  <!-- CTA STRIP -->
  <section class="py-16" style="background-color: var(--color-warm)">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center text-white">
      <h2 class="text-3xl font-black mb-4" style="color: white">Înscrie-ți copilul acum!</h2>
      <p class="text-lg opacity-90 mb-8">Locurile sunt limitate. Contactează-ne pentru mai multe informații.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" style="display: inline-block; border: 2px solid white; color: white; font-weight: 700; padding: 0.75rem 2rem; border-radius: 9999px; text-decoration: none">
          Contactează-ne
        </a>
        <a href="/program-de-vara" style="display: inline-block; background-color: var(--color-brown-dark); color: white; font-weight: 700; padding: 0.75rem 2rem; border-radius: 9999px; text-decoration: none">
          Program de Vară
        </a>
      </div>
    </div>
  </section>

  <!-- GOOGLE MAPS -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="section-title text-center text-3xl mb-4">Unde ne găsești</h2>
      <p class="section-subtitle text-center mb-10">{data.maps_address}</p>
      <div class="rounded-2xl overflow-hidden shadow-lg" style="height: 400px">
        <iframe
          src={data.maps_embed}
          width="100%"
          height="400"
          style="border: 0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Locație Cofferino Hub"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
